# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://repochat:repochat@localhost:5433/repochat

# Embeddings run locally — no API key needed.
# If you change the model, set EMBED_DIM to its output size and re-run `python cli.py init --reset`.
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# LLM: any OpenAI-compatible API. Pick one block.

# OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Gemini (OpenAI-compatible endpoint)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-2.0-flash

# Ollama (local, free)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# Where repos get cloned
REPOS_DIR=./data/repos
TOP_K=8
